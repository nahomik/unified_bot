# ==========================================
# UNIFIED BOT SERVICE ENVIRONMENT VARIABLES
# ==========================================

# 1. Poultry Bot Configuration
POULTRY_BOT_TOKEN=your_poultry_bot_token_from_botfather
POULTRY_SHEET_ID=your_google_sheet_id_for_poultry

# 2. Back Checker Bot Configuration
BACK_CHECKER_BOT_TOKEN=your_back_checker_bot_token_from_botfather

# 3. Field Checker Bot Configuration
FIELD_CHECKER_BOT_TOKEN=your_field_checker_bot_token_from_botfather

# 4. Google Sheets Credentials
# If all bots share the same Google Service Account JSON, set it here once:
GOOGLE_CREDS_JSON={"type": "service_account", "project_id": "...", ...}

# (Optional: If you use different service accounts for different bots, you can override):
# BACK_CHECKER_GOOGLE_CREDS={"type": "service_account", ...}
# FIELD_CHECKER_GOOGLE_CREDS={"type": "service_account", ...}

# 5. Service URL (Render automatically sets RENDER_EXTERNAL_URL)
# BASE_URL=https://unified-bot-service.onrender.com
